# Variabili della pipeline (pipeline/). Copia questo file in .env nella radice del
# repository e compilalo: .env e' escluso da Git. Le variabili d'ambiente hanno
# priorita' su .env. Quelle del sito sono in web/.env.example.
# Non inserire qui credenziali reali.
AWIN_FEED_DOWNLOAD_URL=URL_PRIVATO_FEED_AWIN
GEMINI_API_KEY=CHIAVE_GEMINI
# Chiavi separate facoltative (altrimenti si usa GEMINI_API_KEY)
# GEMINI_FEED_API_KEY=CHIAVE_GEMINI_PER_PULIZIA_TESTO
# GEMINI_EMBEDDING_API_KEY=CHIAVE_GEMINI_EMBEDDING
# GEMINI_VISION_API_KEY=CHIAVE_GEMINI_VISIONE
FEED_ENRICHMENT_MODEL=gemini-3.5-flash-lite
TITLE_REVIEW_MODEL=gemini-3.5-flash-lite

# Database: una stringa unica (Neon: usa quella "unpooled")...
DATABASE_URL=postgresql://UTENTE:PASSWORD@HOST/DATABASE?sslmode=require
# ...oppure le cinque variabili separate (ignorate se c'e' DATABASE_URL)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=TrovAI
# POSTGRES_USER=trovai_app
# POSTGRES_PASSWORD=PASSWORD_PRIVATA

# TROVAI_HOME=/percorso/del/repository      # default: cartella corrente
# TROVAI_ENV_FILE=/percorso/altro.env        # default: $TROVAI_HOME/.env
