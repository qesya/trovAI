# Variabili della pipeline (pipeline/). Le variabili d'ambiente hanno priorita'
# su .streamlit/secrets.toml. Quelle del sito sono in web/.env.example.
# Non inserire qui credenziali reali.
AWIN_FEED_DOWNLOAD_URL=URL_PRIVATO_FEED_AWIN
GEMINI_FEED_API_KEY=CHIAVE_GEMINI_PER_PULIZIA_TESTO
GEMINI_EMBEDDING_API_KEY=CHIAVE_GEMINI_EMBEDDING
GEMINI_VISION_API_KEY=CHIAVE_GEMINI_VISIONE
FEED_ENRICHMENT_MODEL=gemini-3.5-flash-lite
TITLE_REVIEW_MODEL=gemini-3.5-flash-lite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=TrovAI
POSTGRES_USER=trovai_app
POSTGRES_PASSWORD=PASSWORD_PRIVATA
# TROVAI_HOME=/percorso/del/repository      # default: cartella corrente
# TROVAI_SECRETS_FILE=/percorso/secrets.toml
