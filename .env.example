# Copia queste variabili nel tuo ambiente. Non inserire qui credenziali reali.
GEMINI_API_KEY=replace-with-your-gemini-api-key
DATABASE_PATH=shop_database.db
APP_DEBUG=false
LOG_LEVEL=INFO
SITE_NAME=TrovAI
SITE_OWNER=replace-with-legal-name
CONTACT_EMAIL=replace-with-support-email
PRIVACY_EMAIL=replace-with-privacy-email
LEGAL_LAST_UPDATED=19 agosto 2026
PUBLIC_SITE_URL=https://replace-with-public-domain.example
# Impostare true solo dopo aver verificato licenze e diritti su dati, testi e immagini.
CONTENT_RIGHTS_CONFIRMED=false
AWIN_DATAFEED_API_KEY=replace-with-awin-datafeed-key
# Inserisci solo advertiser per cui il tuo account risulta Joined.
AWIN_ADVERTISER_IDS=1234,5678
AWIN_PUBLISHER_ID=replace-with-publisher-id
AWIN_API_TOKEN=replace-with-personal-api-token
AWIN_LINK_BUILDER_ENABLED=false
AWIN_TRACKING_CAMPAIGN=trovai-search
# Impostare true solo dopo aver visto il click di prova nel reporting Awin.
TRACKING_TEST_CONFIRMED=false

# ---------------------------------------------------------------------------
# Pipeline feed (pipeline/): PostgreSQL + Gemini. Vedi pipeline/README.md.
# Le variabili d'ambiente hanno priorita' su .streamlit/secrets.toml.
# ---------------------------------------------------------------------------
AWIN_FEED_DOWNLOAD_URL=URL_PRIVATO_FEED_AWIN
GEMINI_FEED_API_KEY=CHIAVE_GEMINI_PER_PULIZIA_TESTO
GEMINI_EMBEDDING_API_KEY=CHIAVE_GEMINI_EMBEDDING
GEMINI_VISION_API_KEY=CHIAVE_GEMINI_VISIONE
FEED_ENRICHMENT_MODEL=gemini-3.5-flash-lite
TITLE_REVIEW_MODEL=gemini-3.5-flash-lite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=TrovAI
POSTGRES_USER=trovai_app
POSTGRES_PASSWORD=PASSWORD_PRIVATA
# TROVAI_HOME=/percorso/del/repository      # default: cartella corrente
# TROVAI_SECRETS_FILE=/percorso/secrets.toml
