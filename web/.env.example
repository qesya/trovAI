# Copia questo file in .env.local e inserisci i valori reali. Non committare .env.local.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Opzionale: modello Gemini usato per estrarre i filtri.
GEMINI_MODEL=gemini-3.1-flash-lite

# Database: lo stesso PostgreSQL in cui scrive la pipeline (../pipeline).
# Usa DATABASE_URL oppure le variabili POSTGRES_* (gli stessi nomi della pipeline).
# DATABASE_URL=postgresql://trovai_app:PASSWORD_PRIVATA@localhost:5432/TrovAI
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=TrovAI
POSTGRES_USER=trovai_app
POSTGRES_PASSWORD=PASSWORD_PRIVATA

APP_DEBUG=false
SITE_NAME=TrovAI
SITE_OWNER=replace-with-legal-name
CONTACT_EMAIL=replace-with-support-email
PRIVACY_EMAIL=replace-with-privacy-email
LEGAL_LAST_UPDATED=19 agosto 2026
AWIN_PUBLISHER_ID=replace-with-publisher-id
AWIN_API_TOKEN=replace-with-personal-api-token
AWIN_LINK_BUILDER_ENABLED=false
AWIN_TRACKING_CAMPAIGN=trovai-search
